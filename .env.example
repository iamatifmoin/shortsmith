# --- Database (PostgreSQL) ---
# Matches docker-compose.yml defaults for local dev.
DATABASE_URL="postgresql://shortsmith:shortsmith@localhost:5432/shortsmith?schema=public"

# --- Queue (Redis / BullMQ) ---
REDIS_URL="redis://localhost:6379"

# --- LLM provider selection ---
# Provider-agnostic: swap implementations via this flag. See packages/llm.
# Supported: gemini (default, free tier), manual (human paste), anthropic (stub).
LLM_PROVIDER=gemini

# Only the key for the selected provider is required.
# Gemini (default) — free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional: override the quality-ranked model queue (comma-separated, best first).
# GEMINI_MODEL_QUEUE="gemini-flash-latest,gemini-flash-lite-latest"
# Optional: per-attempt timeout (ms); a slow/overloaded model then falls through.
# GEMINI_REQUEST_TIMEOUT_MS=20000
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# --- Phase 4 publishing (Telegram, ADR-033) ---
# Bot that pushes finished clips + copy-paste metadata and takes the `Scheduled`
# reply. Create via @BotFather for the token; message the bot once and the app
# learns your chat id (or set it here). Never logged. Blank = notifications off.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
