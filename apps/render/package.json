    "@nestjs/platform-express": "^11.0.1",
    "@remotion/bundler": "4.0.290",
    "@remotion/renderer": "4.0.290",
    "bullmq": "^5.34.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "^0.2.2",
    "remotion": "4.0.290",
    "rxjs": "^7.8.1"
