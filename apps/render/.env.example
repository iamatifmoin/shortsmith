# App-local env for apps/render (Phase 3). See docs/phase-3-render.md.
# Copy to apps/render/.env and fill in the ElevenLabs key.

REDIS_URL="redis://localhost:6379"

# Ideation API — the export contract (GET /review/:id/export) and the render
# status callbacks (POST /render/jobs/:id/status). ADR-021.
IDEATION_URL="http://localhost:3001"

# ElevenLabs voiceover (ADR-022). Starter plan (commercial). Cheapest model.
# The key may instead live in the repo-root .env — render reads that as a fallback.
TTS_PROVIDER="elevenlabs"   # or "manual" (seam, not implemented)
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="WZlYpi1yf6zJhNWXih74"
ELEVENLABS_MODEL_ID="eleven_turbo_v2_5"
# Voiceover cache (content-keyed; unchanged scripts don't re-voice). Defaults to OUTPUT_DIR/.tts-cache.
# Hook/body/cta are synthesized in ONE request (seamless audio, natural pauses).
# TTS_CACHE_DIR="./out/.tts-cache"

# Local asset library (ADR-024) + render outputs. Keep lean on the dev laptop.
ASSETS_DIR="./assets"
OUTPUT_DIR="./out"

# ffmpeg is used for audio stitching / video. Uses `ffmpeg` on PATH by default;
# set this to an absolute path if it isn't on PATH.
# FFMPEG_PATH="ffmpeg"

# Remotion renders in a headless Chrome. By default we auto-detect an installed
# Chrome/Edge (so renders work offline, without Remotion downloading its own —
# that download is blocked in sandboxed dev and hangs the render). Set this only
# to point at a specific browser binary.
# REMOTION_CHROME=""
# Optional render throttle for a loaded laptop (frames rendered in parallel);
# unset uses Remotion's default (faster).
# REMOTION_CONCURRENCY=""

# B-roll images (ADR-027): keyless Openverse by default — no key needed. For
# higher-quality stock, set ONE of these and it's used instead (Unsplash first).
# UNSPLASH_ACCESS_KEY=""
# PIXABAY_API_KEY=""

# SFX (ADR-027) are fetched from pinned Creative-Commons sources at render time
# (see src/media/sfx.config.ts) and cached under ASSETS_DIR/sfx — no key needed.

# HTTP port for this worker service (health).
PORT=3002
