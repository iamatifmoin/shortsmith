# App-local env for apps/ideation. Prisma reads DATABASE_URL from here.
# Mirrors the repo-root .env.example; keep in sync.

DATABASE_URL="postgresql://shortsmith:shortsmith@localhost:5432/shortsmith?schema=public"
REDIS_URL="redis://localhost:6379"

LLM_PROVIDER=gemini
# Gemini (default) — free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# GEMINI_MODEL_QUEUE="gemini-flash-latest,gemini-flash-lite-latest"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# HTTP port for the NestJS app (review API, health).
PORT=3001

# Phase 4 publishing (ADR-033). Telegram bot that pushes finished clips + copy-paste
# metadata and receives the `Scheduled` reply. Create a bot via @BotFather to get the
# token; message the bot once and the app learns your chat id (or set it explicitly).
# Never logged. Leave blank to disable publish notifications.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
