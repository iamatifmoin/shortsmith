{
  "name": "@shortsmith/ideation",
  "version": "0.1.0",
  "private": true,
  "description": "Ideation pipeline: web sources -> review-ready scripts (NestJS + BullMQ + Prisma).",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "prisma": "prisma",
    "db:seed": "prisma db seed",
    "gen:smoke": "node dist/tools/gen-smoke.js",
    "clean": "rimraf dist"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@shortsmith/llm": "workspace:*",
    "@shortsmith/shared": "workspace:*",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/client": "^6.3.1",
    "bullmq": "^5.34.0",
    "cheerio": "^1.2.0",
    "reflect-metadata": "^0.2.2",
    "rss-parser": "^3.13.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "prisma": "^6.3.1",
    "typescript": "^5.7.3"
  }
}
